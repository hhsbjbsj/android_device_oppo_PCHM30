+/// Mount the GPT partitions a non-A/B phone keeps system, vendor and the
+/// radios on. One that will not mount is logged; the screen still starts.
+#[cfg(target_os = "android")]
+fn prepare_classic(cfg: &DeviceConfig) -> Result<()> {
+    let _ = skyward_sys::ueventd::apply();
+    // (partition, mount point, vfat). modem is the radio firmware volume.
+    let pairs = [
+        ("system", "/system", false),
+        ("vendor", "/vendor", false),
+        ("odm", "/odm", false),
+        ("persist", "/mnt/vendor/persist", false),
+        ("cache", "/cache", false),
+        ("metadata", "/metadata", false),
+        ("modem", "/vendor/firmware_mnt", true),
+    ];
+    for (name, point, vfat) in pairs {
+        let Some(device) = block_named(name) else {
+            let _ = skyward_sys::kmsg(&format!("{name} has no block device"));
+            continue;
+        };
+        std::fs::create_dir_all(point).with_context(|| format!("make {point}"))?;
+        let mounted = if vfat {
+            skyward_block::mount::mount(&device, Path::new(point), "vfat", &["ro".into()]).map(|()| "vfat")
+        } else {
+            skyward_block::mount::mount_ro(&device, Path::new(point)).map(|fs| fs)
+        };
+        match mounted {
+            Ok(fs) => skyward_sys::kmsg(&format!("mounted {name} on {point} ({fs})"))?,
+            Err(e) => skyward_sys::kmsg(&format!("{name} not mounted: {e:#}"))?,
+        }
+    }
+    let persist = Path::new("/mnt/vendor/persist");
+    if skyward_block::mount::is_mount_point(persist).unwrap_or(false) {
+        std::fs::create_dir_all("/persist")?;
+        if let Err(e) = skyward_block::mount::bind(persist, Path::new("/persist")) {
+            skyward_sys::kmsg(&format!("persist not shown at /persist: {e:#}"))?;
+        }
+    }
+    match load_modules(cfg, &cfg.modules.load) {
+        Ok(paths) => {
+            for path in paths {
+                skyward_sys::kmsg(&format!("loaded {}", path.display()))?;
+            }
+        }
+        Err(e) => skyward_sys::kmsg(&format!("modules not loaded: {e:#}"))?,
+    }
+    Ok(())
+}
+
+/// The block device of a GPT partition, once init has linked by-name.
+#[cfg(target_os = "android")]
+fn block_named(name: &str) -> Option<PathBuf> {
+    for root in ["/dev/block/by-name", "/dev/block/bootdevice/by-name"] {
+        let path = Path::new(root).join(name);
+        if path.exists() {
+            return Some(path);
+        }
+    }
+    None
+}
