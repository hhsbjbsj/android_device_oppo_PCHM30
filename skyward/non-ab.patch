+/// The panel can show up a few seconds after pid 1, and not always as card0.
+fn open_surface() -> Result<KmsSurface> {
+    let start = Instant::now();
+    let mut last = String::from("no drm card");
+    loop {
+        let mut tried = false;
+        if let Ok(dir) = fs::read_dir("/dev/dri") {
+            let mut cards: Vec<_> = dir.filter_map(|e| e.ok()).map(|e| e.path()).collect();
+            cards.sort();
+            for path in cards {
+                let Some(name) = path.file_name().and_then(|s| s.to_str()) else { continue };
+                if !name.starts_with("card") {
+                    continue;
+                }
+                tried = true;
+                match KmsSurface::open(&path.to_string_lossy()) {
+                    Ok(surface) => return Ok(surface),
+                    Err(e) => last = format!("{name}: {e:#}"),
+                }
+            }
+        }
+        if !tried {
+            last = "no card under /dev/dri".into();
+        }
+        if start.elapsed() >= Duration::from_secs(20) {
+            return Err(anyhow!(last));
+        }
+        let _ = skyward_sys::kmsg(&format!("display not ready: {last}"));
+        thread::sleep(Duration::from_millis(500));
+    }
+}
